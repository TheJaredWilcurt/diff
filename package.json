{
  "name": "diff",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview --port 4173",
    "lint": "eslint --ext .js,.vue src vite.config.js eslint.config.js",
    "fix": "npm run lint -- --fix",
    "proto": "proto pin node latest --resolve --tool-native && git status"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "vue": "^3.5.44",
    "vue-options-api-constants-plugin": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-vue": "^4.0.1",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-dev-tools-accessibility": "^0.5.6"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.1"
    }
  }
}
